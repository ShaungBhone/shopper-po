{
  "name": "shopper-purchase-orders-formatting",
  "private": true,
  "description": "Development-only source formatting tools for the Shopper addon",
  "scripts": {
    "format": "php vendor/bin/pint && prettier --write \"*.json\" && blade-formatter --write \"resources/views/**/*.blade.php\"",
    "format:check": "prettier --check \"*.json\" && php vendor/bin/pint --test && blade-formatter --check-formatted \"resources/views/**/*.blade.php\""
  },
  "devDependencies": {
    "blade-formatter": "1.44.6",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
